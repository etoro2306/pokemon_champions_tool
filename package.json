{
  "name": "pokemon-champions-tool",
  "private": true,
  "version": "1.0.0",
  "description": "Comparador de estadísticas, Speed Calculator y Damage Calculator para la regulación vigente de Pokémon Champions.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "update:regulation": "tsx scripts/update-regulation.ts"
  },
  "dependencies": {
    "@smogon/calc": "^0.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
